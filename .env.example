# 1. Демо. Для docker compose up .env вообще не нужен.
APP_MODE=demo
PORT=8080
BIND_ADDRESS=127.0.0.1

# 2. Для настоящего входа через Яндекс ID: APP_MODE=production, отдельный том,
# TLS и свой HTTPS origin без завершающего слеша. В демо PUBLIC_URL остаётся пустым.
PUBLIC_URL=
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Встроенные документы — только для теста входа физлицом через Яндекс ID.
# Реальные почту и место хранения базы и копий впишите в свой .env, не в этот файл.
OPERATOR_NAME="Иван Пупкин"
OPERATOR_CONTACT=
OPERATOR_HOSTING=
POLICY_URL=${PUBLIC_URL}/legal/policy
CONSENT_URL=${PUBLIC_URL}/legal/consent
CONSENT_VERSION=test-login-v1

# 3. Необязательные интеграции. Оставьте ключи пустыми для теста Яндекс ID.
# С настоящими сервисами автор их не проверял. До подключения подготовьте свои документы.
# SMS.RU
SMS_API_ID=
# Госуслуги через выделенный OIDC-шлюз ЕСИА. Issuer — не URL портала Госуслуг.
ESIA_ISSUER=
ESIA_CLIENT_ID=
ESIA_CLIENT_SECRET=
# Подписанный атрибут фактического провайдера в id_token шлюза.
ESIA_SOURCE_CLAIM=idp
ESIA_SOURCE_VALUE=esia
# ЮKassa
YOO_SHOP_ID=
YOO_SECRET=
