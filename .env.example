# Без ключей: изолированные демонстрационные данные, никаких реальных SMS или платежей.
APP_MODE=demo
PORT=8080
BIND_ADDRESS=127.0.0.1
# Демо: оставьте PUBLIC_URL пустым — ссылки откроются на текущем сайте и порту.
# Для реального входа: свой HTTPS origin без слеша, например https://cabinet.example.ru;
# нужны новая БД/том, HTTPS reverse proxy и согласованное размещение в РФ.
PUBLIC_URL=
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
# Встроенные документы — только для теста входа физлицом через Яндекс ID.
OPERATOR_NAME="Иван Пупкин"
# Для реальных аккаунтов укажите действующую почту для запросов/отзывов согласия.
OPERATOR_CONTACT=
# Укажите исполнителя хостинга и фактическое место хранения базы и резервных копий.
OPERATOR_HOSTING=
POLICY_URL=${PUBLIC_URL}/legal/policy
CONSENT_URL=${PUBLIC_URL}/legal/consent
CONSENT_VERSION=test-login-v1
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Issuer выделенного OIDC-шлюза с единственным способом входа ЕСИА. Не URL портала Госуслуг.
ESIA_ISSUER=
ESIA_CLIENT_ID=
ESIA_CLIENT_SECRET=
# Подписанный атрибут о фактическом внешнем провайдере в id_token брокера.
ESIA_SOURCE_CLAIM=idp
ESIA_SOURCE_VALUE=esia
SMS_API_ID=
YOO_SHOP_ID=
YOO_SECRET=
