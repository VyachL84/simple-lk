# Без ключей: изолированные демонстрационные данные, никаких реальных SMS или платежей.
APP_MODE=demo
PORT=8080
BIND_ADDRESS=127.0.0.1
# production: новая БД/том, HTTPS reverse proxy, хранение в РФ.
PUBLIC_URL=
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
OPERATOR_CONTACT=
POLICY_URL=
CONSENT_URL=
CONSENT_VERSION=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Issuer выделенного OIDC-шлюза с единственным способом входа ЕСИА. Не URL портала Госуслуг.
ESIA_ISSUER=
ESIA_CLIENT_ID=
ESIA_CLIENT_SECRET=
# Подписанный атрибут о фактическом внешнем провайдере в id_token брокера.
ESIA_SOURCE_CLAIM=idp
ESIA_SOURCE_VALUE=esia
SMS_API_ID=
YOO_SHOP_ID=
YOO_SECRET=
